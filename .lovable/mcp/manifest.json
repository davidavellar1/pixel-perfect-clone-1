{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vlefzxcumqbrsypkipmt.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "dhc-market-dev-test",
      "version": "0.1.0",
      "title": "DHC Market dev test"
    },
    "tools": [
      {
        "name": "search_opportunities",
        "title": "Search listed opportunities",
        "description": "Search anonymized listed projects. Qualified information and accepted identity use the same gates as the interface. Figures are developer-stated and unverified.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free text matched against the anonymized teaser title."
            },
            "countryCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                {
                  "type": "null"
                }
              ],
              "description": "Two-letter country code, e.g. FR."
            },
            "technology": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Primary technology, e.g. waste_heat, geothermal."
            },
            "lifecycleStage": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lifecycle stage, e.g. development, construction."
            },
            "minCapacityMw": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum capacity band floor in MW."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum results to return (default 10)."
            }
          },
          "required": [
            "query",
            "countryCode",
            "technology",
            "lifecycleStage",
            "minCapacityMw",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project profile",
        "description": "Return a teaser, qualified de-identified information and separately accepted identity. Figures are developer-stated and unverified.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "publicRef": {
              "type": "string",
              "format": "uuid",
              "description": "Opaque project reference (publicRef), as returned by search_opportunities."
            }
          },
          "required": [
            "publicRef"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_watchlist",
        "title": "List my watchlist",
        "description": "List the resolved user's saved projects with qualification and acceptance disclosure gates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_to_watchlist",
        "title": "Add project to my watchlist",
        "description": "Save a listed project for the resolved user. Does not express interest or request data-room access.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "publicRef": {
              "type": "string",
              "format": "uuid",
              "description": "Opaque project reference (publicRef) to save, as returned by search_opportunities."
            }
          },
          "required": [
            "publicRef"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_access_requests",
        "title": "List my access requests",
        "description": "List the resolved investor's requests and dates with teaser-first project disclosure.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
